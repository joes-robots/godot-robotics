<!-- A small model using the features the importer supports: default classes and
     childclass, an include, degrees, euler and fromto, every joint type, motor,
     position and velocity actuators, and sensors. -->
<mujoco model="test_arm">
  <compiler angle="degree"/>
  <option timestep="0.004" integrator="implicitfast"/>
  <include file="arm_defaults.xml"/>
  <worldbody>
    <geom name="floor" type="plane" size="5 5 0.1"/>
    <body name="base" pos="0 0 0.1">
      <geom name="pedestal" type="cylinder" size="0.1 0.1"/>
      <body name="upper" pos="0 0 0.2" euler="0 0 30" childclass="link">
        <joint name="shoulder" axis="0 1 0" range="-90 90"/>
        <geom name="upper_link" fromto="0 0 0 0.5 0 0"/>
        <body name="lower" pos="0.5 0 0">
          <joint name="elbow" axis="0 1 0" range="-120 120" damping="1"/>
          <geom name="lower_link" class="thin" fromto="0 0 0 0.4 0 0"/>
          <site name="tip" pos="0.4 0 0" size="0.02"/>
        </body>
      </body>
    </body>
    <body name="ball" pos="1 0 1">
      <freejoint name="ball_free"/>
      <geom name="ball_geom" type="sphere" size="0.1" mass="2"/>
    </body>
    <body name="slider" pos="-1 0 0.5">
      <joint name="slide" type="slide" axis="1 0 0" range="-0.3 0.3"/>
      <geom name="slider_box" type="box" size="0.1 0.1 0.1"/>
      <body name="wobble" pos="0 0 0.2" quat="0.9238795 0.3826834 0 0">
        <joint name="ball_joint" type="ball"/>
        <geom name="wobble_geom" type="ellipsoid" size="0.05 0.08 0.1" pos="0 0 0.1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="shoulder_servo" joint="shoulder" class="servo"/>
    <position name="elbow_servo" joint="elbow" class="servo" kp="50"/>
    <motor name="slide_motor" joint="slide" gear="20" ctrlrange="-1 1"/>
    <velocity name="slide_damper" joint="slide" kv="3"/>
  </actuator>
  <sensor>
    <jointpos name="shoulder_pos" joint="shoulder"/>
    <framepos name="tip_pos" objtype="site" objname="tip"/>
    <framequat name="ball_quat" objtype="xbody" objname="ball"/>
    <accelerometer name="tip_acc" site="tip"/>
    <actuatorfrc name="elbow_force" actuator="elbow_servo"/>
  </sensor>
</mujoco>
