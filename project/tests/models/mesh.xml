<!-- Meshes for test_mesh: inline and from STL and OBJ files (in meshdir), scaled,
     shared by two geoms, from a class, and a box fitted to a mesh. The bodies swing
     on joints, so their motion depends on the meshes' mass and inertia; nothing
     lands or tumbles, which would make the comparison chaotic. -->
<mujoco model="meshes">
  <compiler meshdir="meshes" angle="radian"/>
  <asset>
    <mesh name="tetra" scale="0.2 0.2 0.3" vertex="0 0 0  1 0 0  0 1 0  0 0 1" face="0 2 1  0 1 3  0 3 2  1 2 3"/>
    <mesh file="wedge.stl"/>
    <mesh file="octahedron.obj" scale="0.1 0.1 0.1"/>
  </asset>
  <default>
    <default class="part">
      <geom type="mesh" density="500" rgba="0.8 0.5 0.2 1"/>
    </default>
  </default>
  <worldbody>
    <body name="tetra_body" pos="0 0 1" euler="0.3 0.2 0.1">
      <joint name="tetra_hinge" axis="0 1 0" pos="0.1 0.3 0.2"/>
      <geom name="tetra_a" class="part" mesh="tetra"/>
      <geom name="tetra_b" class="part" mesh="tetra" pos="0.3 0 0" euler="0 0 1.5"/>
    </body>
    <body name="wedge_body" pos="1 0 1">
      <joint name="wedge_hinge" axis="1 0.2 0" pos="0 0.05 0.3"/>
      <geom name="wedge" type="mesh" mesh="wedge"/>
    </body>
    <body name="oct_body" pos="-1 0 1" euler="0.4 0 0">
      <joint name="oct_ball" type="ball" pos="0.05 0 0.3"/>
      <geom name="oct" class="part" mesh="octahedron"/>
      <geom name="fitted" type="box" mesh="octahedron" pos="0 0 0.3" mass="0.1"/>
    </body>
  </worldbody>
</mujoco>
