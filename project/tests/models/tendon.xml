<!-- Tendons and joint limit settings for test_tendons: a fixed tendon from a class,
     a spatial tendon wrapping a cylinder with a side site, a pulley, tendon
     actuators and sensors. -->
<mujoco model="tendons">
  <compiler angle="radian" autolimits="true"/>
  <default>
    <joint damping="0.5"/>
    <tendon width="0.005" rgba="0.9 0.2 0.2 1"/>
    <default class="limb">
      <joint solreflimit="0.05 1" solimplimit="0.8 0.9 0.01 0.5 2" margin="0.01" range="-1 1"/>
      <tendon stiffness="5" damping="0.5" limited="true" range="-0.5 0.5" solreflimit="0.04 1.2" margin="0.002"/>
    </default>
  </default>
  <worldbody>
    <site name="anchor" pos="0 0 2"/>
    <site name="side" pos="0.7 0 1.9"/>
    <geom name="drum" type="cylinder" size="0.1 0.05" pos="0.5 0 1.6" zaxis="0 1 0" contype="0" conaffinity="0"/>
    <body name="arm" pos="0 0 1.2" childclass="limb">
      <joint name="shoulder" axis="0 1 0"/>
      <joint name="twist" axis="0 0 1"/>
      <geom type="capsule" fromto="0 0 0 0.4 0 0" size="0.04"/>
      <site name="elbow_site" pos="0.4 0 0"/>
      <body name="forearm" pos="0.4 0 0">
        <joint name="elbow" axis="0 1 0" actuatorfrcrange="-3 3"/>
        <geom type="capsule" fromto="0 0 0 0.3 0 0" size="0.03"/>
        <site name="hand" pos="0.3 0 0"/>
      </body>
    </body>
    <body name="weight" pos="1 0 1">
      <joint name="drop" type="slide" axis="0 0 1" range="-0.5 0.5"/>
      <geom type="sphere" size="0.08"/>
      <site name="hook"/>
    </body>
  </worldbody>
  <tendon>
    <fixed name="couple" class="limb">
      <joint joint="shoulder" coef="1"/>
      <joint joint="elbow" coef="-0.5"/>
    </fixed>
    <spatial name="cable" springlength="0.9" stiffness="20" damping="1" actuatorfrclimited="true" actuatorfrcrange="-1 1">
      <site site="anchor"/>
      <geom geom="drum" sidesite="side"/>
      <site site="hook"/>
    </spatial>
    <spatial name="split" range="0 3">
      <site site="anchor"/>
      <site site="elbow_site"/>
      <pulley divisor="2"/>
      <site site="anchor"/>
      <site site="hand"/>
    </spatial>
  </tendon>
  <actuator>
    <position name="couple_servo" tendon="couple" kp="10" kv="1" ctrlrange="-1 1"/>
    <motor name="cable_motor" tendon="cable" gear="2"/>
  </actuator>
  <sensor>
    <tendonpos name="couple_len" tendon="couple"/>
    <tendonvel name="cable_vel" tendon="cable"/>
  </sensor>
</mujoco>
