[configuration]

entry_symbol = "mujoco_physics_library_init"
compatibility_minimum = "4.4"
reloadable = false

[libraries]
; Relative paths ensure that our GDExtension can be placed anywhere in the project directory.
macos.single.debug = "./macos/libMUJOCO-PHYSICS.macos.template_debug.dylib"
macos.double.debug = "./macos/libMUJOCO-PHYSICS.macos.template_debug.double.dylib"
macos.single.release = "./macos/libMUJOCO-PHYSICS.macos.template_release.dylib"
macos.double.release = "./macos/libMUJOCO-PHYSICS.macos.template_release.double.dylib"

ios.arm64.single.debug = "./ios/libMUJOCO-PHYSICS.ios.template_debug.arm64.dylib"
ios.arm64.double.debug = "./ios/libMUJOCO-PHYSICS.ios.template_debug.arm64.double.dylib"
ios.arm64.single.release = "./ios/libMUJOCO-PHYSICS.ios.template_release.arm64.dylib"
ios.arm64.double.release = "./ios/libMUJOCO-PHYSICS.ios.template_release.arm64.double.dylib"

windows.x86_32.single.debug = "./windows/MUJOCO-PHYSICS.windows.template_debug.x86_32.dll"
windows.x86_32.double.debug = "./windows/MUJOCO-PHYSICS.windows.template_debug.x86_32.double.dll"
windows.x86_32.single.release = "./windows/MUJOCO-PHYSICS.windows.template_release.x86_32.dll"
windows.x86_32.double.release = "./windows/MUJOCO-PHYSICS.windows.template_release.x86_32.double.dll"

windows.x86_64.single.debug = "./windows/MUJOCO-PHYSICS.windows.template_debug.x86_64.dll"
windows.x86_64.double.debug = "./windows/MUJOCO-PHYSICS.windows.template_debug.x86_64.double.dll"
windows.x86_64.single.release = "./windows/MUJOCO-PHYSICS.windows.template_release.x86_64.dll"
windows.x86_64.double.release = "./windows/MUJOCO-PHYSICS.windows.template_release.x86_64.double.dll"

linux.x86_64.single.debug = "./linux/libMUJOCO-PHYSICS.linux.template_debug.x86_64.so"
linux.x86_64.double.debug = "./linux/libMUJOCO-PHYSICS.linux.template_debug.x86_64.double.so"
linux.x86_64.single.release = "./linux/libMUJOCO-PHYSICS.linux.template_release.x86_64.so"
linux.x86_64.double.release = "./linux/libMUJOCO-PHYSICS.linux.template_release.x86_64.double.so"

linux.arm64.single.debug = "./linux/libMUJOCO-PHYSICS.linux.template_debug.arm64.so"
linux.arm64.double.debug = "./linux/libMUJOCO-PHYSICS.linux.template_debug.arm64.double.so"
linux.arm64.single.release = "./linux/libMUJOCO-PHYSICS.linux.template_release.arm64.so"
linux.arm64.double.release = "./linux/libMUJOCO-PHYSICS.linux.template_release.arm64.double.so"

linux.rv64.single.debug = "./linux/libMUJOCO-PHYSICS.linux.template_debug.rv64.so"
linux.rv64.double.debug = "./linux/libMUJOCO-PHYSICS.linux.template_debug.rv64.double.so"
linux.rv64.single.release = "./linux/libMUJOCO-PHYSICS.linux.template_release.rv64.so"
linux.rv64.double.release = "./linux/libMUJOCO-PHYSICS.linux.template_release.rv64.double.so"

android.x86_64.single.debug = "./android/libMUJOCO-PHYSICS.android.template_debug.x86_64.so"
android.x86_64.double.debug = "./android/libMUJOCO-PHYSICS.android.template_debug.x86_64.double.so"
android.x86_64.single.release = "./android/libMUJOCO-PHYSICS.android.template_release.x86_64.so"
android.x86_64.double.release = "./android/libMUJOCO-PHYSICS.android.template_release.x86_64.double.so"

android.arm64.single.debug = "./android/libMUJOCO-PHYSICS.android.template_debug.arm64.so"
android.arm64.double.debug = "./android/libMUJOCO-PHYSICS.android.template_debug.arm64.double.so"
android.arm64.single.release = "./android/libMUJOCO-PHYSICS.android.template_release.arm64.so"
android.arm64.double.release = "./android/libMUJOCO-PHYSICS.android.template_release.arm64.double.so"

web.wasm32.single.debug = "./web/libMUJOCO-PHYSICS.web.template_debug.wasm32.nothreads.wasm"
web.wasm32.double.debug = "./web/libMUJOCO-PHYSICS.web.template_debug.wasm32.double.nothreads.wasm"
web.wasm32.single.release = "./web/libMUJOCO-PHYSICS.web.template_release.wasm32.nothreads.wasm"
web.wasm32.double.release = "./web/libMUJOCO-PHYSICS.web.template_release.wasm32.double.nothreads.wasm"

[dependencies]

linux.x86_64.single.debug = {
    "res://bin/linux/libmujoco.so.3.10.0" : ""
}
linux.x86_64.double.debug = {
    "res://bin/linux/libmujoco.so.3.10.0" : ""
}
linux.x86_64.single.release = {
    "res://bin/linux/libmujoco.so.3.10.0" : ""
}
linux.x86_64.double.release = {
    "res://bin/linux/libmujoco.so.3.10.0" : ""
}